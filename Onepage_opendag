<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MBO Open Dag</title>

    <style>
        /* =========================
           BASIS
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f8fc;
            color: #102f52;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            width: 100%;
            display: block;
        }

        .container {
            width: min(1180px, 92%);
            margin: auto;
        }

        /* =========================
           NAVIGATIE
        ========================= */

        header {
            background: white;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 20px rgba(0,0,0,0.08);
        }

        nav {
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 26px;
            font-weight: 900;
            color: #102f52;
        }

        .logo span {
            color: #f8c928;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
            font-size: 15px;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: #e6b400;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 25px;
            background: #ffd52f;
            color: #102f52;
            border-radius: 10px;
            font-weight: 800;
            border: none;
            cursor: pointer;
            transition: 0.25s;
        }

        .button:hover {
            background: #f5c400;
            transform: translateY(-2px);
        }

        .menu {
            display: none;
            font-size: 27px;
            cursor: pointer;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 520px;
            background:
                linear-gradient(90deg,
                rgba(8,43,75,0.98) 0%,
                rgba(8,43,75,0.88) 42%,
                rgba(8,43,75,0.15) 100%),
                url("https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;
            background-position: center;
            color: white;

            display: flex;
            align-items: center;
        }

        .hero-content {
            max-width: 650px;
            padding: 80px 0;
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .hero h1 {
            font-size: clamp(45px, 6vw, 76px);
            line-height: 0.98;
            margin-bottom: 25px;
        }

        .hero h1 span {
            color: #ffd52f;
        }

        .hero p {
            max-width: 560px;
            font-size: 18px;
            margin-bottom: 30px;
            color: #edf4fb;
        }


        /* =========================
           EVENT INFO
        ========================= */

        .event-card {
            background: white;
            border-radius: 18px;
            padding: 25px 30px;
            box-shadow: 0 15px 45px rgba(16,47,82,0.15);

            display: grid;
            grid-template-columns: 1fr 1fr 200px;
            gap: 25px;
            align-items: center;

            margin-top: -45px;
            position: relative;
            z-index: 10;
        }

        .event-item {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .event-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #eaf2fb;
            display: grid;
            place-items: center;
            font-size: 20px;
        }

        .event-item strong {
            display: block;
            font-size: 14px;
        }

        .event-item small {
            color: #68798c;
        }


        /* =========================
           SECTIES
        ========================= */

        section {
            padding: 90px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-title h2 {
            font-size: 42px;
            line-height: 1.1;
            margin-bottom: 12px;
        }

        .section-title p {
            color: #64768a;
        }


        /* =========================
           VERWACHTINGEN
        ========================= */

        .expectations {
            background: white;
        }

        .expectation-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .expectation {
            padding: 35px 25px;
            background: #f5f8fc;
            border-radius: 16px;
            text-align: center;
            transition: 0.25s;
        }

        .expectation:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(16,47,82,0.1);
        }

        .expectation-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: #dfeefa;
            display: grid;
            place-items: center;
            font-size: 28px;
        }

        .expectation h3 {
            margin-bottom: 8px;
        }

        .expectation p {
            color: #68798c;
            font-size: 14px;
        }


        /* =========================
           OPLEIDINGEN
        ========================= */

        .opleiding-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            margin-bottom: 35px;
        }

        .opleiding-header h2 {
            font-size: 40px;
        }

        .opleiding-header a {
            font-weight: 700;
        }

        .opleiding-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .opleiding-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(16,47,82,0.08);
            transition: 0.25s;
        }

        .opleiding-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(16,47,82,0.15);
        }

        .opleiding-card img {
            height: 190px;
            object-fit: cover;
        }

        .opleiding-content {
            padding: 22px;
        }

        .opleiding-content h3 {
            margin-bottom: 6px;
        }

        .opleiding-content p {
            color: #68798c;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .more {
            color: #0a5ca8;
            font-size: 14px;
            font-weight: 800;
        }


        /* =========================
           TESTIMONIAL
        ========================= */

        .testimonial {
            background: #eaf3fb;
        }

        .testimonial-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: white;
            border-radius: 22px;
            overflow: hidden;
        }

        .testimonial-image {
            min-height: 380px;
            background:
                url("https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1000&q=80")
                center/cover;
        }

        .testimonial-text {
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .quote {
            font-size: 55px;
            color: #ffd52f;
            line-height: 0.5;
            margin-bottom: 25px;
        }

        .testimonial-text blockquote {
            font-size: 27px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 25px;
        }

        .student {
            color: #64768a;
        }


        /* =========================
           LOCATIE
        ========================= */

        .location-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 35px;
            align-items: stretch;
        }

        .map {
            min-height: 350px;
            border-radius: 18px;
            overflow: hidden;
            background: #dfe9d8;
            position: relative;
        }

        .map::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(35deg, transparent 48%, #fff 49%, #fff 51%, transparent 52%),
                linear-gradient(120deg, transparent 47%, #fff 48%, #fff 50%, transparent 51%),
                repeating-linear-gradient(20deg, #dfe9d8 0 45px, #cfdcc9 46px 48px);
        }

        .map-pin {
            position: absolute;
            top: 48%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 55px;
            height: 55px;
            background: #0a5ca8;
            color: white;
            border-radius: 50% 50% 50% 0;
            transform: translate(-50%, -50%) rotate(-45deg);
            display: grid;
            place-items: center;
        }

        .map-pin span {
            transform: rotate(45deg);
        }

        .location-info {
            padding: 20px;
        }

        .location-info h2 {
            font-size: 40px;
            margin-bottom: 25px;
        }

        .location-item {
            display: flex;
            gap: 15px;
            margin-bottom: 22px;
        }

        .location-item strong {
            display: block;
        }

        .location-item p {
            color: #68798c;
        }


        /* =========================
           FAQ
        ========================= */

        .faq {
            background: white;
        }

        .faq-container {
            max-width: 850px;
            margin: auto;
        }

        .faq-item {
            border-bottom: 1px solid #dfe5eb;
        }

        .faq-question {
            width: 100%;
            border: none;
            background: none;
            padding: 22px 5px;
            display: flex;
            justify-content: space-between;
            font-size: 16px;
            font-weight: 700;
            color: #102f52;
            cursor: pointer;
            text-align: left;
        }

        .faq-answer {
            display: none;
            padding: 0 5px 22px;
            color: #68798c;
        }

        .faq-item.active .faq-answer {
            display: block;
        }

        .faq-item.active .faq-question span {
            transform: rotate(180deg);
        }


        /* =========================
           CTA
        ========================= */

        .cta {
            background: #092e52;
            color: white;
            text-align: center;
            padding: 80px 20px;
            position: relative;
            overflow: hidden;
        }

        .cta::after {
            content: "🎓";
            position: absolute;
            right: 10%;
            bottom: -30px;
            font-size: 150px;
            opacity: 0.08;
        }

        .cta h2 {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .cta p {
            color: #c9d9e8;
            margin-bottom: 28px;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #061f38;
            color: white;
            padding: 30px 0;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-links {
            display: flex;
            gap: 25px;
            color: #b7c8d9;
            font-size: 14px;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {

            .nav-links {
                display: none;
            }

            .menu {
                display: block;
            }

            .nav-button {
                display: none;
            }

            .hero {
                min-height: 600px;
            }

            .event-card {
                grid-template-columns: 1fr;
                margin-top: -30px;
            }

            .expectation-grid,
            .opleiding-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .testimonial-box {
                grid-template-columns: 1fr;
            }

            .testimonial-image {
                min-height: 280px;
            }

            .location-grid {
                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 600px) {

            section {
                padding: 65px 0;
            }

            .hero-content {
                padding: 60px 0;
            }

            .hero h1 {
                font-size: 50px;
            }

            .hero p {
                font-size: 16px;
            }

            .event-card {
                padding: 20px;
            }

            .expectation-grid,
            .opleiding-grid {
                grid-template-columns: 1fr;
            }

            .section-title h2,
            .opleiding-header h2,
            .location-info h2 {
                font-size: 32px;
            }

            .opleiding-header {
                display: block;
            }

            .opleiding-header a {
                display: inline-block;
                margin-top: 10px;
            }

            .testimonial-text {
                padding: 35px;
            }

            .testimonial-text blockquote {
                font-size: 22px;
            }

            .cta h2 {
                font-size: 35px;
            }

            .footer-inner {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }

            .footer-links {
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>
</head>


<body>

    <!-- =========================
         NAVIGATIE
    ========================== -->

    <header>
        <div class="container">
            <nav>

                <a href="#" class="logo">
                    MBO<span>+</span>
                </a>

                <ul class="nav-links">
                    <li><a href="#verwachten">Open dag</a></li>
                    <li><a href="#opleidingen">Opleidingen</a></li>
                    <li><a href="#locatie">Locatie</a></li>
                    <li><a href="#faq">FAQ</a></li>
                </ul>

                <a href="#aanmelden" class="button nav-button">
                    Aanmelden →
                </a>

                <div class="menu">☰</div>

            </nav>
        </div>
    </header>


    <!-- =========================
         HERO
    ========================== -->

    <main>

        <section class="hero">

            <div class="container">

                <div class="hero-content">

                    <div class="eyebrow">
                        MBO Open Dag
                    </div>

                    <h1>
                        Ontdek jouw
                        <span>toekomst</span>
                    </h1>

                    <p>
                        Kom langs en ervaar zelf wat het MBO voor jou kan betekenen.
                        Bekijk opleidingen, ontmoet studenten en doe mee aan leuke activiteiten.
                    </p>

                    <a href="#aanmelden" class="button">
                        Aanmelden voor de open dag →
                    </a>

                </div>

            </div>

        </section>


        <!-- =========================
             EVENT INFO
        ========================== -->

        <div class="container">

            <div class="event-card">

                <div class="event-item">
                    <div class="event-icon">📅</div>

                    <div>
                        <strong>Zaterdag 15 maart 2025</strong>
                        <small>10:00 – 15:00</small>
                    </div>
                </div>


                <div class="event-item">
                    <div class="event-icon">📍</div>

                    <div>
                        <strong>MBO College Utrecht</strong>
                        <small>Laan van de Techniek 10, Utrecht</small>
                    </div>
                </div>


                <a href="#aanmelden" class="button">
                    Aanmelden →
                </a>

            </div>

        </div>


        <!-- =========================
             WAT KUN JE VERWACHTEN
        ========================== -->

        <section class="expectations" id="verwachten">

            <div class="container">

                <div class="section-title">

                    <h2>Wat kun je verwachten?</h2>

                    <p>
                        Tijdens de open dag beleef je het echte MBO.
                        Ontdek, proef, vraag en ervaar.
                    </p>

                </div>


                <div class="expectation-grid">

                    <div class="expectation">

                        <div class="expectation-icon">🎓</div>

                        <h3>Opleidingen</h3>

                        <p>
                            Bekijk alle opleidingen en praat met docenten en studenten.
                        </p>

                    </div>


                    <div class="expectation">

                        <div class="expectation-icon">👥</div>

                        <h3>Studenten</h3>

                        <p>
                            Hoor hun verhalen en stel al je vragen.
                        </p>

                    </div>


                    <div class="expectation">

                        <div class="expectation-icon">⚙️</div>

                        <h3>Workshops</h3>

                        <p>
                            Doe mee en ervaar zelf hoe het is.
                        </p>

                    </div>


                    <div class="expectation">

                        <div class="expectation-icon">🏫</div>

                        <h3>Rondleiding</h3>

                        <p>
                            Krijg een kijkje achter de schermen.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             OPLEIDINGEN
        ========================== -->

        <section id="opleidingen">

            <div class="container">

                <div class="opleiding-header">

                    <div>
                        <h2>Ontdek onze opleidingen</h2>
                        <p>Vind de opleiding die bij jou past.</p>
                    </div>

                    <a href="#">
                        Bekijk alle opleidingen →
                    </a>

                </div>


                <div class="opleiding-grid">


                    <article class="opleiding-card">

                        <img
                            src="https://images.unsplash.com/photo-1581092918484-8313c3b4c7d8?auto=format&fit=crop&w=800&q=80"
                            alt="Techniek opleiding">

                        <div class="opleiding-content">

                            <h3>Techniek</h3>

                            <p>
                                Bouw mee aan de toekomst.
                            </p>

                            <a class="more" href="#">
                                Bekijk opleiding →
                            </a>

                        </div>

                    </article>


                    <article class="opleiding-card">

                        <img
                            src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80"
                            alt="Zorg opleiding">

                        <div class="opleiding-content">

                            <h3>Zorg & Welzijn</h3>

                            <p>
                                Zorg voor een betere wereld.
                            </p>

                            <a class="more" href="#">
                                Bekijk opleiding →
                            </a>

                        </div>

                    </article>


                    <article class="opleiding-card">

                        <img
                            src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=800&q=80"
                            alt="Economie opleiding">

                        <div class="opleiding-content">

                            <h3>Economie & Handel</h3>

                            <p>
                                Van idee naar succes.
                            </p>

                            <a class="more" href="#">
                                Bekijk opleiding →
                            </a>

                        </div>

                    </article>


                    <article class="opleiding-card">

                        <img
                            src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=800&q=80"
                            alt="Horeca opleiding">

                        <div class="opleiding-content">

                            <h3>Horeca & Bakkerij</h3>

                            <p>
                                Gastvrijheid zit in jou.
                            </p>

                            <a class="more" href="#">
                                Bekijk opleiding →
                            </a>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- =========================
             TESTIMONIAL
        ========================== -->

        <section class="testimonial">

            <div class="container">

                <div class="testimonial-box">

                    <div class="testimonial-image"></div>

                    <div class="testimonial-text">

                        <div class="quote">“</div>

                        <blockquote>
                            Bij het MBO krijg je de ruimte om jezelf te ontwikkelen.
                            Ik heb hier mijn plek gevonden!
                        </blockquote>

                        <div class="student">
                            — Sam, student Techniek
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             LOCATIE
        ========================== -->

        <section id="locatie">

            <div class="container">

                <div class="location-grid">

                    <div class="map">

                        <div class="map-pin">
                            <span>📍</span>
                        </div>

                    </div>


                    <div class="location-info">

                        <h2>Zo vind je ons</h2>


                        <div class="location-item">

                            <div>📍</div>

                            <div>
                                <strong>Adres</strong>
                                <p>
                                    Laan van de Techniek 10<br>
                                    Utrecht
                                </p>
                            </div>

                        </div>


                        <div class="location-item">

                            <div>🚌</div>

                            <div>
                                <strong>Openbaar vervoer</strong>
                                <p>
                                    Goed bereikbaar met het OV.
                                </p>
                            </div>

                        </div>


                        <div class="location-item">

                            <div>🚗</div>

                            <div>
                                <strong>Parkeren</strong>
                                <p>
                                    Ruime parkeergelegenheid aanwezig.
                                </p>
                            </div>

                        </div>


                        <a href="#" class="more">
                            Bekijk route →
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             FAQ
        ========================== -->

        <section class="faq" id="faq">

            <div class="container">

                <div class="section-title">

                    <h2>Veelgestelde vragen</h2>

                    <p>
                        Antwoorden op de meest gestelde vragen.
                    </p>

                </div>


                <div class="faq-container">


                    <div class="faq-item">

                        <button class="faq-question">
                            Moet ik mij aanmelden voor de open dag?
                            <span>⌄</span>
                        </button>

                        <div class="faq-answer">
                            Ja, aanmelden is handig zodat we weten hoeveel bezoekers
                            we kunnen verwachten.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Mag ik iemand meenemen?
                            <span>⌄</span>
                        </button>

                        <div class="faq-answer">
                            Natuurlijk! Je mag bijvoorbeeld je ouders, vrienden
                            of begeleider meenemen.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Welke opleidingen kan ik bekijken?
                            <span>⌄</span>
                        </button>

                        <div class="faq-answer">
                            Tijdens de open dag kun je verschillende opleidingen
                            en richtingen bekijken.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Is de open dag gratis?
                            <span>⌄</span>
                        </button>

                        <div class="faq-answer">
                            Ja, de open dag is gratis.
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             CTA
        ========================== -->

        <section class="cta" id="aanmelden">

            <div class="container">

                <div class="eyebrow">
                    Klaar om te komen?
                </div>

                <h2>
                    Meld je vandaag nog aan!
                </h2>

                <p>
                    We kijken ernaar uit je te ontmoeten.
                </p>

                <a href="#" class="button">
                    Aanmelden →
                </a>

            </div>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="container">

            <div class="footer-inner">

                <div class="logo">
                    MBO<span>+</span>
                </div>

                <div class="footer-links">
                    <a href="#">Contact</a>
                    <a href="#">Privacy</a>
                    <a href="#">Instagram</a>
                    <a href="#">TikTok</a>
                </div>

            </div>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        /* FAQ openen/sluiten */

        const faqItems = document.querySelectorAll(".faq-item");

        faqItems.forEach(item => {

            const question = item.querySelector(".faq-question");

            question.addEventListener("click", () => {

                item.classList.toggle("active");

            });

        });


        /* Mobiele navigatie */

        const menu = document.querySelector(".menu");
        const navLinks = document.querySelector(".nav-links");

        menu.addEventListener("click", () => {

            if (navLinks.style.display === "flex") {

                navLinks.style.display = "none";

            } else {

                navLinks.style.display = "flex";
                navLinks.style.flexDirection = "column";
                navLinks.style.position = "absolute";
                navLinks.style.top = "76px";
                navLinks.style.left = "0";
                navLinks.style.right = "0";
                navLinks.style.background = "white";
                navLinks.style.padding = "25px";

            }

        });

    </script>

</body>
